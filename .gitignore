# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generated blueprints -- output, not source.
/out/

# Serena's local index.
/.serena/

# The web front end's build output and dependencies. `dist/` above already
# covers web/dist; these are the rest of what bun and rsbuild leave behind.
node_modules/
/web/.rsbuild/
/web/coverage/

# The C# snap oracle builds against the game DLLs; neither the build output
# nor the copied-in engine assemblies belong in the repository.
/oracle/bin/
/oracle/obj/
