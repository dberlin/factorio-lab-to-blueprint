{
  "name": "flab2bp-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"bun run dev:api\" \"bun run dev:frontend:local\"",
    "dev:api": "uv run --directory .. flab2bp-web --no-build",
    "dev:frontend:local": "wait-on http-get://127.0.0.1:8000/api/health && rsbuild dev",
    "dev:frontend": "rsbuild dev",
    "build": "rsbuild build",
    "test": "rstest run",
    "test:watch": "rstest watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint .",
    "format": "biome format --write .",
    "extract-assets": "uv run scripts/extract_assets.py"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@rsbuild/core": "2.1.13",
    "@rsbuild/plugin-react": "2.1.0",
    "@rstest/core": "0.11.8",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@typescript-eslint/parser": "8.67.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0"
  }
}
