+                grid,
+                flags,
+                (start,),
+                (goal,),
+                global_router._CapacityLedger(grid.size),
+                frozenset(),
+                FeedbackState((2, 1), {}, {}),
+                net_id,
+                100,
+                None,
+                movement=movement,
