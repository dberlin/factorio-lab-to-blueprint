+        ),
+        entry=replace(candidate.entry, dock=cell(candidate.entry.dock)),
+        exit=replace(candidate.exit, dock=cell(candidate.exit.dock)),
+        foreign_keepout=frozenset(cell(value) for value in candidate.foreign_keepout),
+    )
