+    def _junctions_clear(self, cells: tuple[Cell, ...], frame: _JunctionProjectionFrame) -> bool:
+        if not cells or not self._coaters:
+            return True
+        if not self._base_clear(frame):
+            return False
+        banned = self._coater_frame_bans.get(frame)
+        if banned is None:
+            # Reuse the pack-level predicate for every stack and projection
+            # once, rather than rebuilding immutable coater broad phases for
+            # each novel tap and anchor.
+            (banned,) = _projected_coater_junction_bans_by_frame(
+                self._coaters,
+                (frame,),
+                self.capacity,
+                already_banned=frozenset(),
+                belt_rules=self.belt_rules,
+                splitter_index=len(self.buildings),
+                cancelled=self.cancelled,
+                cache=self._coater_cache,
